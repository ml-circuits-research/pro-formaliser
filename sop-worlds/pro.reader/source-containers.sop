# A definite, unnamed alias identifies the live container of an existing target.
@pro.reader.source_container core.type of=pro.reader.source_container closed=true
@pro.reader.source_container.family core.slot of=pro.reader.source_container key=family kind=atom required=true
@pro.reader.source_container.affected_family core.slot of=pro.reader.source_container key=affected_family kind=atom required=true many=true
@pro.reader.source_container.text core.slot of=pro.reader.source_container key=text kind=string many=true required=true

@reader.source_container.drawing pro.reader.source_container family=page affected_family=drawn affected_family=group affected_family=part text=scene text=canvas
@reader.source_container.document pro.reader.source_container family=document affected_family=paragraph affected_family=block affected_family=section affected_family=chapter affected_family=inline affected_family=text text=document
