# These request acts can retain a written object pronoun without choosing an instance or a family.
@pro.reader.reference_command core.type of=pro.reader.reference_command closed=true
@pro.reader.reference_command.act core.slot of=pro.reader.reference_command key=act kind=atom required=true

@reader.reference_command.remove pro.reader.reference_command act=remove
@reader.reference_command.deselect pro.reader.reference_command act=deselect
