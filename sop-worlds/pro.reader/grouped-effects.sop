# Each adjacent value must be known for a different property of the same owner.
@reader.effects.bundle.direct pro.reader.coordinated_effects part=assignment part=owner part=bundle
@reader.effects.bundle.to pro.reader.coordinated_effects part=assignment part=owner part=to part=bundle
@reader.effects.bundle.into pro.reader.coordinated_effects part=assignment part=owner part=into part=bundle
@reader.effects.bundle.to.article pro.reader.coordinated_effects part=assignment part=owner part=to part=article part=bundle
@reader.effects.bundle.into.article pro.reader.coordinated_effects part=assignment part=owner part=into part=article part=bundle

@reader.effect.scene.owner pro.reader.effect_owner family=page text=scene text=picture text="whole scene" text="entire scene" text="whole picture" text="entire picture" text="whole page" text="entire page" text=weather
