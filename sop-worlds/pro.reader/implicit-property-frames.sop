# These assignment shapes name the property directly. The owner is resolved
# on the active page within each compatible catalog family.
@reader.en.set.context w.lang.en.frame name=reader.set.context act=change mode=set set=acts priority=12 needs=attrs role=attribute role=value example="Set the width to 15"
@reader.en.set.context.1 w.lang.en.part frame=reader.set.context at=1 is=lead phrase=lead.polite optional=yes
@reader.en.set.context.2 w.lang.en.part frame=reader.set.context at=2 is=word word=set word=change
@reader.en.set.context.3 w.lang.en.part frame=reader.set.context at=3 is=det optional=yes
@reader.en.set.context.4 w.lang.en.part frame=reader.set.context at=4 is=role role=attribute takes=lexicon lexicon=attribute
@reader.en.set.context.5 w.lang.en.part frame=reader.set.context at=5 is=word word=to
@reader.en.set.context.6 w.lang.en.part frame=reader.set.context at=6 is=role role=value takes=words

# With no value connector, the written operand has to select a finite value
# declared for the same property.
@reader.en.make.context w.lang.en.frame name=reader.make.context act=change mode=set set=acts priority=12 needs=values role=attribute role=value example="Make the width medium"
@reader.en.make.context.1 w.lang.en.part frame=reader.make.context at=1 is=lead phrase=lead.polite optional=yes
@reader.en.make.context.2 w.lang.en.part frame=reader.make.context at=2 is=word word=make
@reader.en.make.context.3 w.lang.en.part frame=reader.make.context at=3 is=det optional=yes
@reader.en.make.context.4 w.lang.en.part frame=reader.make.context at=4 is=role role=attribute takes=lexicon lexicon=attribute
@reader.en.make.context.5 w.lang.en.part frame=reader.make.context at=5 is=role role=value takes=words
