# Series names and the categorical field that generates series are different roles.
@pilot.chart.intended_use w.request.key tab=diagram family=chart name=chart.intendedUse head=span about="the written deliverable or context for which the chart is requested"
@pilot.chart.series_dimension w.request.key tab=diagram family=chart name=chart.seriesDimension head=span about="the data field whose category values define the separate series in a chart"
@pilot.chart.series_column_vertical pro.reader.analytical_owner_property tab=diagram family=chart owner_key=chart.type owner_value=bar text="a stacked column chart" text="a grouped column chart" text="a clustered column chart" key=chart.orientation value=vertical
@pilot.chart.series_stacked pro.reader.analytical_owner_property tab=diagram family=chart owner_key=chart.type owner_value=bar text="a stacked bar chart" text="a stacked column chart" key=chart.stacking value=stacked
@pilot.chart.series_grouped pro.reader.analytical_owner_property tab=diagram family=chart owner_key=chart.type owner_value=bar text="a grouped bar chart" text="a grouped column chart" text="a clustered bar chart" text="a clustered column chart" key=chart.stacking value=none
@pilot.chart.series_legend core.word of=chart.legend means=left text="on the left"
@pilot.chart.series_legend_right core.word of=chart.legend means=right text="on the right"
@pilot.chart.series_print_values core.word of=chart.show_values means=show text="with the values printed on the marks" text="with the values shown on the bars" text="with the values shown on the marks"
@pilot.chart.series_split_label pro.reader.argument_label key=chart.seriesDimension text="split by" text="broken down by" text=across
@pilot.chart.series_legend_label pro.reader.argument_label key=chart.legend text="put the legend" text="with the legend"
@pilot.chart.series_use_label pro.reader.argument_label key=chart.intendedUse text=for

@pilot.chart.series_layout pro.reader.analytical_frame tab=diagram family=chart layout=ordered_fields owner_key=chart.type owner_value=bar owner="a stacked bar chart" owner="a stacked column chart" owner="a grouped bar chart" owner="a grouped column chart" owner="a clustered bar chart" owner="a clustered column chart" prefix=make prefix=build prefix=draw prefix="give me" prefix="show me" prefix="maybe make" pattern="{$owner} of {chart.measure} by {chart.dimension}, broken down by {chart.seriesDimension}" pattern="{$owner} of {chart.measure} by {chart.dimension}, split by {chart.seriesDimension}" pattern="{$owner} of {chart.measure} by {chart.dimension} and {chart.seriesDimension}" pattern="{$owner} of {chart.aggregate} {chart.measure} broken down by {chart.dimension} and {chart.seriesDimension}" pattern="{$owner} of {chart.measure} across {chart.seriesDimension} for each {chart.dimension}" pattern="{$owner} of {chart.measure} by {chart.dimension}, broken down by {chart.seriesDimension}, and put the legend {chart.legend}" pattern="{$owner} of {chart.measure} by {chart.dimension}, split by {chart.seriesDimension}, with the legend {chart.legend}" pattern="{$owner} of {chart.measure} by {chart.dimension} and {chart.seriesDimension}, and put the legend {chart.legend}" pattern="{$owner} of {chart.aggregate} {chart.measure} broken down by {chart.dimension} and {chart.seriesDimension}, {chart.show_values}" pattern="{$owner} of {chart.measure} by {chart.dimension} and {chart.seriesDimension} for {chart.intendedUse}, and put the legend {chart.legend}" pattern="{$owner} of {chart.aggregate} {chart.measure} broken down by {chart.dimension} and {chart.seriesDimension} for {chart.intendedUse}, {chart.show_values}" open_boundary=or open_boundary="so the" open_boundary=except
