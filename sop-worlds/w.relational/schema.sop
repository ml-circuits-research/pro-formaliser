# Proposed additive module for relationships explicitly stated in a request.
@w.relational core.module name=w.relational version=1 imports=w.request exports=predicate exports=reciprocal exports=shared exports=scaled exports=source_scope exports=beneficiary exports=landmark_pair
@w.relational.world std.schema.world name=w.relational doc="Explicit relationships among selected things and their properties"

# A directed binary predicate with a known meaning. Both directions must hold
# for the pair in a reciprocal request. Surface aliases belong in core.word.
@w.relational.predicate core.type of=w.relational.predicate closed=true
@w.relational.predicate.name core.slot of=w.relational.predicate key=name kind=atom required=true present=true
@w.relational.predicate.about core.slot of=w.relational.predicate key=about kind=string required=true present=true

# members is a selected pair. Resolution is deferred when the two identities
# are unknown. No left/right value is chosen while reading the utterance.
@w.relational.reciprocal core.type of=w.relational.reciprocal closed=true
@w.relational.reciprocal.request core.slot of=w.relational.reciprocal key=request type=w.request.request required=true present=true
@w.relational.reciprocal.members core.slot of=w.relational.reciprocal key=members type=w.request.target required=true present=true
@w.relational.reciprocal.predicate core.slot of=w.relational.reciprocal key=predicate type=w.relational.predicate required=true present=true
@w.relational.reciprocal.words core.slot of=w.relational.reciprocal key=words kind=string required=true present=true

# At the result, every member of this set must agree on the designated
# property. The common value can remain unknown.
@w.relational.shared core.type of=w.relational.shared closed=true
@w.relational.shared.request core.slot of=w.relational.shared key=request type=w.request.request required=true present=true
@w.relational.shared.members core.slot of=w.relational.shared key=members type=w.request.target required=true present=true
@w.relational.shared.property core.slot of=w.relational.shared key=property type=w.request.key required=true present=true
@w.relational.shared.words core.slot of=w.relational.shared key=words kind=string required=true present=true

# result[result_key] = factor * source[source_key] at the stated source phase.
# A single target may serve as both source and result on different properties.
@w.relational.scaled core.type of=w.relational.scaled closed=true
@w.relational.scaled.request core.slot of=w.relational.scaled key=request type=w.request.request required=true present=true
@w.relational.scaled.result core.slot of=w.relational.scaled key=result type=w.request.target required=true present=true
@w.relational.scaled.result_key core.slot of=w.relational.scaled key=result_key type=w.request.key required=true present=true
@w.relational.scaled.source core.slot of=w.relational.scaled key=source type=w.request.target required=true present=true
@w.relational.scaled.source_key core.slot of=w.relational.scaled key=source_key type=w.request.key required=true present=true
@w.relational.scaled.source_phase core.slot of=w.relational.scaled key=source_phase enum=initial enum=result required=true present=true
@w.relational.scaled.factor core.slot of=w.relational.scaled key=factor kind=number required=true present=true
@w.relational.scaled.words core.slot of=w.relational.scaled key=words kind=string required=true present=true

# Resolve the written container in the current page context and constrain
# the affected selection to that source. The container is not an action target.
@w.relational.source_scope core.type of=w.relational.source_scope closed=true
@w.relational.source_scope.request core.slot of=w.relational.source_scope key=request type=w.request.request required=true present=true
@w.relational.source_scope.affected core.slot of=w.relational.source_scope key=affected type=w.request.target required=true present=true
@w.relational.source_scope.container_family core.slot of=w.relational.source_scope key=container_family kind=atom required=true present=true
@w.relational.source_scope.container_words core.slot of=w.relational.source_scope key=container_words kind=string required=true present=true
@w.relational.source_scope.lookup core.slot of=w.relational.source_scope key=lookup enum=page required=true present=true
@w.relational.source_scope.words core.slot of=w.relational.source_scope key=words kind=string required=true present=true

# Explicitly stated counts must agree with the requested relation.
@w.relational.check.members w.request.target count=?count
@w.relational.check.pair w.relational.reciprocal members=$w.relational.check.members
@w.relational.check.group w.relational.shared members=$w.relational.check.members
@w.relational.check.not_two core.check fn=neq args=?count args=2
@w.relational.check.too_few core.check fn=lt args=?count args=2
@w.relational.check.pair_count core.deny when=$w.relational.check.members when=$w.relational.check.pair if=$w.relational.check.not_two why="A reciprocal pair requires two selected members."
@w.relational.check.shared_count core.deny when=$w.relational.check.members when=$w.relational.check.group if=$w.relational.check.too_few why="A shared property requires at least two selected members."

# All referenced endpoints belong to this request.
@w.relational.check.target w.request.target request=?target_request family=?target_family
@w.relational.check.different_request core.check fn=neq args=?target_request args=?relation_request
@w.relational.check.shared_members w.relational.shared request=?relation_request members=$w.relational.check.target
@w.relational.check.shared_members.owner core.deny when=$w.relational.check.shared_members when=$w.relational.check.target if=$w.relational.check.different_request why="The relation and target belong to different requests."
@w.relational.check.reciprocal_members w.relational.reciprocal request=?relation_request members=$w.relational.check.target
@w.relational.check.reciprocal_members.owner core.deny when=$w.relational.check.reciprocal_members when=$w.relational.check.target if=$w.relational.check.different_request why="The relation and target belong to different requests."
@w.relational.check.scaled_source w.relational.scaled request=?relation_request source=$w.relational.check.target
@w.relational.check.scaled_source.owner core.deny when=$w.relational.check.scaled_source when=$w.relational.check.target if=$w.relational.check.different_request why="The relation and target belong to different requests."
@w.relational.check.scaled_result w.relational.scaled request=?relation_request result=$w.relational.check.target
@w.relational.check.scaled_result.owner core.deny when=$w.relational.check.scaled_result when=$w.relational.check.target if=$w.relational.check.different_request why="The relation and target belong to different requests."
@w.relational.check.source_scope w.relational.source_scope request=?relation_request affected=$w.relational.check.target
@w.relational.check.source_scope.owner core.deny when=$w.relational.check.source_scope when=$w.relational.check.target if=$w.relational.check.different_request why="The source scope and affected target belong to different requests."

# The beneficiary is distinct from the object created. Its identity may need resolution.
@w.relational.beneficiary core.type of=w.relational.beneficiary closed=true
@w.relational.beneficiary.request core.slot of=w.relational.beneficiary key=request type=w.request.request required=true present=true
@w.relational.beneficiary.kind core.slot of=w.relational.beneficiary key=kind enum=pronoun enum=name required=true present=true
@w.relational.beneficiary.value core.slot of=w.relational.beneficiary key=value kind=string required=true present=true
@w.relational.beneficiary.words core.slot of=w.relational.beneficiary key=words kind=string required=true present=true

# The selector constraints are resolved independently. The first and second
# fields record source order. Neither landmark is another affected target.
@w.relational.landmark_pair core.type of=w.relational.landmark_pair closed=true
@w.relational.landmark_pair.request core.slot of=w.relational.landmark_pair key=request type=w.request.request required=true present=true
@w.relational.landmark_pair.affected core.slot of=w.relational.landmark_pair key=affected type=w.request.target required=true present=true
@w.relational.landmark_pair.first core.slot of=w.relational.landmark_pair key=first type=w.request.constraint required=true present=true
@w.relational.landmark_pair.second core.slot of=w.relational.landmark_pair key=second type=w.request.constraint required=true present=true
@w.relational.landmark_pair.mode core.slot of=w.relational.landmark_pair key=mode enum=between enum=midpoint required=true present=true
@w.relational.landmark_pair.words core.slot of=w.relational.landmark_pair key=words kind=string required=true present=true

@w.relational.check.pair_first w.relational.landmark_pair request=?relation_request first=$w.relational.check.anchor
@w.relational.check.pair_second w.relational.landmark_pair request=?relation_request second=$w.relational.check.anchor
@w.relational.check.pair_affected w.relational.landmark_pair request=?relation_request affected=$w.relational.check.target
@w.relational.check.anchor w.request.constraint request=?target_request
@w.relational.check.pair_first.owner core.deny when=$w.relational.check.pair_first when=$w.relational.check.anchor if=$w.relational.check.different_request why="The first landmark belongs to a different request."
@w.relational.check.pair_second.owner core.deny when=$w.relational.check.pair_second when=$w.relational.check.anchor if=$w.relational.check.different_request why="The second landmark belongs to a different request."
@w.relational.check.pair_affected.owner core.deny when=$w.relational.check.pair_affected when=$w.relational.check.target if=$w.relational.check.different_request why="The affected target belongs to a different request."
@w.relational.check.pair_duplicate w.relational.landmark_pair first=?anchor second=?anchor
@w.relational.check.pair_duplicate.deny core.deny when=$w.relational.check.pair_duplicate why="A landmark pair requires two distinct selector wires."

# Both references must resolve to explicit selectors with their own page lookups.
@w.relational.check.pair_selector w.request.constraint request=?relation_request on=place operator=relation phase=selector attribute=?key value=?text
@w.relational.check.pair_selector.identity core.calc out=?w.relational.check.pair_selector fn=concat args=?w.relational.check.anchor
@w.relational.check.pair_lookup w.request.lookup request=?relation_request constraint=$w.relational.check.anchor key=thing from=page
@w.relational.check.pair_first_selector core.deny when=$w.relational.check.pair_first when=$w.relational.check.anchor with=$w.relational.check.pair_selector.identity not=$w.relational.check.pair_selector why="The first landmark requires a written place selector."
@w.relational.check.pair_second_selector core.deny when=$w.relational.check.pair_second when=$w.relational.check.anchor with=$w.relational.check.pair_selector.identity not=$w.relational.check.pair_selector why="The second landmark requires a written place selector."
@w.relational.check.pair_first_lookup core.deny when=$w.relational.check.pair_first when=$w.relational.check.anchor not=$w.relational.check.pair_lookup why="The first landmark requires a same-request page lookup."
@w.relational.check.pair_second_lookup core.deny when=$w.relational.check.pair_second when=$w.relational.check.anchor not=$w.relational.check.pair_lookup why="The second landmark requires a same-request page lookup."
