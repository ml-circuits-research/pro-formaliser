# One threshold predicate scoped to the chart's declared measure and grouping.
@pilot.chart.filter_scope w.request.key tab=diagram family=chart name=chart.filterScope head=span about="the written observations or groups restricted by the chart predicate"
@pilot.chart.filter_operator w.request.key tab=diagram family=chart name=chart.filterOperator head=class value=gt value=lt value=ge value=le about="comparison of the chart measure for each scoped member against the threshold"
@pilot.chart.filter_threshold w.request.key tab=diagram family=chart name=chart.filterThreshold head=span about="written threshold literal or reference to resolve against the chart measure"
@pilot.chart.filter.gt core.word text=above text="greater than" text="more than" text="higher than" means=gt of=chart.filterOperator
@pilot.chart.filter.lt core.word text=below text="less than" text="lower than" means=lt of=chart.filterOperator
@pilot.chart.filter.ge core.word text="at least" means=ge of=chart.filterOperator
@pilot.chart.filter.le core.word text="at most" means=le of=chart.filterOperator

@pilot.chart.bar.filter pro.reader.analytical_frame tab=diagram family=chart layout=ordered_fields owner_key=chart.type owner_value=bar prefix=make prefix=draw prefix=build prefix=try prefix="show me" prefix="give me" owner="a bar chart" owner="a column chart" pattern="{$owner} of {chart.measure} by {chart.dimension} — only {chart.filterScope} {chart.filterOperator} {chart.filterThreshold}" pattern="{$owner} of {chart.measure} by {chart.dimension}, only {chart.filterScope} {chart.filterOperator} {chart.filterThreshold}" pattern="{$owner} of {chart.measure} by {chart.dimension} only {chart.filterScope} {chart.filterOperator} {chart.filterThreshold}"
@pilot.chart.line.filter pro.reader.analytical_frame tab=diagram family=chart layout=ordered_fields owner_key=chart.type owner_value=line prefix=make prefix=draw prefix=build prefix=try prefix="show me" prefix="give me" owner="a line chart" owner="a line graph" pattern="{$owner} of {chart.measure} by {chart.dimension} — only {chart.filterScope} {chart.filterOperator} {chart.filterThreshold}" pattern="{$owner} of {chart.measure} by {chart.dimension}, only {chart.filterScope} {chart.filterOperator} {chart.filterThreshold}" pattern="{$owner} of {chart.measure} by {chart.dimension} only {chart.filterScope} {chart.filterOperator} {chart.filterThreshold}"

@pilot.chart.discourse.meanwhile w.lang.en.skip class=filler text=meanwhile text="and meanwhile"
@pilot.chart.restrictor.only pro.reader.argument_label key=chart.filterScope text=only
