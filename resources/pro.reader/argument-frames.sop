# Chart argument order and connector wording are explicit. Written field names are open spans.
# Scatter data mappings have no x/y field slots. Preserve those spans as unread.
@reader.chart.scatter.colour_mapping pro.reader.argument_sequence tab=diagram family=chart act=make mode=new prefix="give me" prefix="show me" prefix="make" prefix="draw" prefix="try" prefix="i need to see" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" owner_key=chart.type owner_value=scatter part="$owner" part=of part="$unread" part=against part="$unread" part="," part="coloured by" part=chart.colourBy tail="for the"
@reader.chart.scatter.regression pro.reader.argument_sequence tab=diagram family=chart act=make mode=new prefix="give me" prefix="show me" prefix="make" prefix="draw" prefix="try" prefix="i need to see" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" owner_key=chart.type owner_value=scatter part="$owner" part=of part="$unread" part="plotted by" part="$unread" part="," part=chart.trendLine tail=","
@reader.chart.scatter.colour_owner pro.reader.argument_sequence tab=diagram family=chart act=make mode=new prefix="let's do" prefix="make" prefix="give me" prefix="show me" prefix="try" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" owner_key=chart.type owner_value=scatter part="$owner" part=with part=chart.colourBy part="deciding the colour of each mark"
@reader.chart.line.period_aggregate pro.reader.argument_sequence tab=diagram family=chart act=make mode=new prefix="try" prefix="make" prefix="show" prefix="show me" prefix="give me" owner="a line chart" owner="line chart" owner_key=chart.type owner_value=line part="$owner" part=of part=chart.period part=chart.aggregate part=of part=chart.measure
@reader.chart.bar.trailing_owner pro.reader.argument_sequence tab=diagram family=chart act=make mode=new prefix="show" prefix="show me" prefix="give me" prefix="we want" prefix="display" owner="a bar chart" owner="bar chart" owner_key=chart.type owner_value=bar part=chart.aggregate part=chart.measure part=versus part=chart.dimension part=as part="$owner"
@reader.chart.existing_aggregate pro.reader.argument_sequence tab=diagram family=chart act=change mode=existing prefix="show" owner=chart part=the part=chart.aggregate part=of part=chart.measure part=on part=the part="$owner"
# Fixed phrases support the canonical effect only; the complete written wording remains attached.
@reader.chart.line.year_on_year core.word text=year-on-year means=year of=chart.period
@reader.chart.aggregate.averages core.word text=averages means=avg of=chart.aggregate
@reader.chart.scatter.linear_fit core.word text="with a regression line" text="with a regression line through it" text="with a fitted regression line" means=show of=chart.trendLine
