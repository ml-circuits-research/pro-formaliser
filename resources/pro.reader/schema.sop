# Optional bindings between an application's declared kinds and w.request targets.
@pro.reader core.module name=pro.reader version=1 exports=target exports=spatial exports=evidence_role exports=preservation exports=literal exports=tuple
@pro.reader.target core.type of=pro.reader.target closed=true
@pro.reader.target.of core.slot of=pro.reader.target key=of kind=atom
@pro.reader.target.family core.slot of=pro.reader.target key=family kind=atom required=true
@pro.reader.target.sort core.slot of=pro.reader.target key=sort kind=atom kind=string
@pro.reader.target.mode core.slot of=pro.reader.target key=mode enum=new enum=existing enum=bound
@pro.reader.target.text core.slot of=pro.reader.target key=text kind=atom kind=string many=true
@pro.reader.target.act core.slot of=pro.reader.target key=act kind=atom kind=string many=true
@pro.reader.target.tab core.slot of=pro.reader.target key=tab kind=atom

# Slot names for a family's spatial relation and its grounded nominal anchor.
@pro.reader.spatial core.type of=pro.reader.spatial closed=true
@pro.reader.spatial.tab core.slot of=pro.reader.spatial key=tab kind=atom required=true
@pro.reader.spatial.family core.slot of=pro.reader.spatial key=family kind=atom required=true
@pro.reader.spatial.relation_key core.slot of=pro.reader.spatial key=relation_key kind=atom required=true
@pro.reader.spatial.anchor_key core.slot of=pro.reader.spatial key=anchor_key kind=atom required=true

@pro.reader.evidence_role core.type of=pro.reader.evidence_role closed=true
@pro.reader.evidence_role.role core.slot of=pro.reader.evidence_role key=role kind=atom required=true
@pro.reader.evidence_role.type core.slot of=pro.reader.evidence_role key=type kind=atom required=true
@pro.reader.evidence_role.slot core.slot of=pro.reader.evidence_role key=slot kind=atom required=true
@pro.reader.evidence_role.phase core.slot of=pro.reader.evidence_role key=phase enum=selector enum=result


# A family's declared class key for preserving current state.
@pro.reader.preservation core.type of=pro.reader.preservation closed=true
@pro.reader.preservation.family core.slot of=pro.reader.preservation key=family kind=atom required=true
@pro.reader.preservation.attribute core.slot of=pro.reader.preservation key=attribute kind=atom required=true

# An optional concept shares a learned preservation construction across declared keys.
@pro.reader.preservation.concept core.slot of=pro.reader.preservation key=concept kind=atom

# An open span key that fills a literal role in the family's request.
@pro.reader.literal core.type of=pro.reader.literal closed=true
@pro.reader.literal.family core.slot of=pro.reader.literal key=family kind=atom required=true
@pro.reader.literal.attribute core.slot of=pro.reader.literal key=attribute kind=atom required=true
@pro.reader.literal.role core.slot of=pro.reader.literal key=role enum=payload enum=name required=true
@pro.reader.literal.text core.slot of=pro.reader.literal key=text kind=string many=true

# Two ordered, open number keys read together after a declared cue.
@pro.reader.tuple core.type of=pro.reader.tuple closed=true
@pro.reader.tuple.family core.slot of=pro.reader.tuple key=family kind=atom required=true
@pro.reader.tuple.tab core.slot of=pro.reader.tuple key=tab kind=atom required=true
@pro.reader.tuple.first_key core.slot of=pro.reader.tuple key=first_key kind=atom required=true
@pro.reader.tuple.second_key core.slot of=pro.reader.tuple key=second_key kind=atom required=true
@pro.reader.tuple.act core.slot of=pro.reader.tuple key=act kind=atom many=true required=true
@pro.reader.tuple.text core.slot of=pro.reader.tuple key=text kind=string many=true required=true
